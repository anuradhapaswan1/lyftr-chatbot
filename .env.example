# Comma-separated key pool (>= 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-key-1,your-key-2
# Any LiteLLM model name. Keys must belong to that provider.
LLM_MODEL=gemini/gemini-2.5-flash
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
# disk (persists in /data) or local (in-memory)
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
LLM_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=50
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Frontend container only: backend URL as seen from the browser
API_URL=http://localhost:8000
# Local-only for `npm run dev` / static hosts (build time): VITE_API_URL=https://your-backend.example.com
